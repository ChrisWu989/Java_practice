Deque<Integer> d = new ArrayDeque<>();
d.push(1);
d.push(2);
d.push(3); // 3, 2, 1
System.out.println(d.pollFirst()); // removes 3
System.out.println(d.poll()); // removes 2
System.out.println(d.pollLast());// removes 1

