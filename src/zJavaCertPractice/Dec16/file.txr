abstract class Base{
    abstract int power();
}

class A extends Base{
@Override
int power(){ return 0; }
}

public class TestClass
{

   static void processBase(Base base){
      A a = null;
      if(base instanceof A a ){
        System.out.println(a.power());
        }
        System.out.println("a is "+a);
    }
  
  public static void main(String args[]){
    processBase(new A());
  }
}

1. 0
a is A@5acf98000
2. a is null0
3. <stack trace for NullPointerException>
4. <stack trace for NullPointerException>
5. a is null
6. Compilation failure. // True

